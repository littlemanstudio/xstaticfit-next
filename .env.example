# Copy to .env.local for local development. Never commit real secrets.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contact@xstaticfit.com

# Klaviyo (server only, secret). Marketing flows: welcome, abandoned checkout, post-purchase.
# Private API key: Klaviyo > Settings > API keys, scopes: profiles:write, subscriptions:write, events:write.
# List id: Klaviyo > Audience > Lists, the "Newsletter" list id. Leave empty to turn it all off.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Meta Pixel (public). Intended value: the "Xstatic Fit Pixel" dataset.
# Leave empty to turn ALL Meta tracking off (no script, no banner, no network calls).
NEXT_PUBLIC_META_PIXEL_ID=1748428746254894

# Meta Conversions API (server only, secret). Generate in Events Manager >
# Xstatic Fit Pixel > Settings > Conversions API > Generate access token.
META_CAPI_ACCESS_TOKEN=
# Optional. Only while testing: the code shown in Events Manager > Test events.
# Remove it in production or real events show up as test events only.
META_TEST_EVENT_CODE=
# Optional. 1 = log every Conversions API payload (user data hashed) to the server log.
# dry = log the payload and do NOT send it to Meta (local testing).
META_CAPI_DEBUG=
